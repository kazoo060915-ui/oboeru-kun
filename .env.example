# ⚠️ このファイルは Git にコミットされる「雛形」です。
# 実際のキーは絶対にここに書かないこと。値は .env.local に書く（gitignore 済み）。

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
# DB アクセスはすべてサーバー（Route Handler）経由。RLS を全拒否にしてあるため
# anon キーは使わない。service role キーは RLS をバイパスするので絶対に
# NEXT_PUBLIC_ を付けないこと（付けるとブラウザに配信される）。
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic Claude API Key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Simple Auth Passcode (簡易認証コード)
# 例のような分かりやすい値のまま本番にデプロイしないこと。
# 公開URL + 短い推測可能なパスコードの組み合わせは、突破されると
# /api/chat 等が第三者向けの汎用 Claude プロキシとして動いてしまう
# （課金は自分のAPIキーに乗る）。長いランダム文字列に変更すること。
AUTH_PASSCODE=change-me-to-a-long-random-string

# Notification Configuration
# LINE 通知（Messaging API の push を使う）
# 旧 LINE Notify は 2025-03-31 でサービス終了したため使えない。
# LINE Developers でチャネルを作成し、以下の2つを設定する。
#   - LINE_CHANNEL_ACCESS_TOKEN: チャネルアクセストークン（長期）
#   - LINE_USER_ID: 送信先ユーザーID（自分のID。Webhook や LINE Official Account Manager で確認できる）
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_USER_ID=your-line-user-id

# Email Configuration (Resend)
#
# NOTIFICATION_FROM_EMAIL は独自ドメインを Resend で検証済みの場合のみ設定する。
# 未設定なら onboarding@resend.dev が使われる（ドメイン検証なしで唯一送れるアドレス。
# ただし宛先は Resend に登録した自分のアドレスに限られる）。
# 検証していないドメインを指定すると送信が必ず失敗するので、迷うなら空のままにする。
RESEND_API_KEY=your-resend-api-key
# NOTIFICATION_FROM_EMAIL=oboeru@your-verified-domain.com
NOTIFICATION_TO_EMAIL=user@example.com

# Cron / Webhook Secret for /api/notify
CRON_SECRET=your-cron-secret-key
