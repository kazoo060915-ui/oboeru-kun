# ⚠️ このファイルは Git にコミットされる「雛形」です。
# 実際のキーは絶対にここに書かないこと。値は .env.local に書く（gitignore 済み）。

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
# DB アクセスはすべてサーバー（Route Handler）経由。RLS を全拒否にしてあるため
# anon キーは使わない。service role キーは RLS をバイパスするので絶対に
# NEXT_PUBLIC_ を付けないこと（付けるとブラウザに配信される）。
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic Claude API Key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Simple Auth Passcode (簡易認証コード)
AUTH_PASSCODE=oboeru2026

# Notification Configuration
# LINE Notification Token
LINE_NOTIFY_TOKEN=your-line-notify-token

# Email Configuration (e.g., Resend or SendGrid)
RESEND_API_KEY=your-resend-api-key
NOTIFICATION_FROM_EMAIL=oboeru@example.com
NOTIFICATION_TO_EMAIL=user@example.com

# Cron / Webhook Secret for /api/notify
CRON_SECRET=your-cron-secret-key
